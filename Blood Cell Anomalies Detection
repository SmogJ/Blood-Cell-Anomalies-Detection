rs=morph[5:8], kind=\"scatter\", height=7, aspect=1)\n\nplt.savefig(\"cell_type_vs_nucleus_area_chromatin_density_sytoplasmic_ratio.jpeg\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-09-07T15:58:53.462384Z","iopub.execute_input":"2026-09-07T15:58:53.462914Z","iopub.status.idle":"2026-09-07T15:58:54.464199Z","shell.execute_reply.started":"2026-09-07T15:58:53.462872Z","shell.execute_reply":"2026-09-07T15:58:54.463253Z"}},"outputs":[{"output_type":"display_data","data":{"text/plain":"<Figure size 2100x700 with 3 Axes>","image/png":"\n"},"metadata":{}}],"execution_count":30},{"cell_type":"markdown","source":"* Age and Sex are important in chromatin density, male infants have higher chromatin density, but this changes slightly in the elderly where females have higher density\n* The presence of chromatin and nucleus area differentiates RBCs, abnormal RBC (i.e. 0), and Platelets from WBCs and Infections which are 40 % above for nu. \n* Another differetiator is the Cytoplasm ratio which is 1 for RBCs, and Platelets and varies for WBCs and infections\n\n[Wikipedia - Nuclear–cytoplasmic ratio](https://en.wikipedia.org/wiki/Nuclear%E2%80%93cytoplasmic_ratio)\n\n[Allied Guru - Morphology of Normal Blood Cells and Their Identification](https://alliedguru.com/morphology-of-normal-blood-cells-and-their-identification/)","metadata":{}},{"cell_type":"code","source":"# Eccentricity measure of how mush a cell deviate from being circular\n\nsns.catplot(data, y=morph[2], x=\"cell_type\" , kind=\"box\", errorbar=None, aspect=2)\nplt.tick_params(axis=\"x\", rotation=90)\nplt.savefig(\"eccentricity_cell_type.jpeg\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-09-07T15:58:54.46561Z","iopub.execute_input":"2026-09-07T15:58:54.46611Z","iopub.status.idle":"2026-09-07T15:58:55.122659Z","shell.execute_reply.started":"2026-09-07T15:58:54.466063Z","shell.execute_reply":"2026-09-07T15:58:55.121624Z"}},"outputs":[{"output_type":"display_data","data":{"t