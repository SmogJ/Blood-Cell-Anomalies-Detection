ide a dataframe (df).\")\n","\n","    # Get categorical and numerical columns\n","    cat_cols = df.select_dtypes(include=object).columns[cols:]\n","    num_cols = df.select_dtypes(exclude=object).columns[1:]\n","\n","    # Features (X) and Target (y)\n","    X = df.drop(columns=\"anomaly_label\")\n","    y = df[\"anomaly_label\"]\n","\n","    # Drop leaky features\n","    if feat_drop is not None:\n","        X = X.drop(columns=feat_drop)\n","\n","    # Train/test split\n","    X_train, X_test, y_train, y_test = train_test_split(\n","        X, y, test_size=0.3, random_state=42, stratify=y\n","    )\n","\n","    # Transformers\n","    transformers = []\n","    if scaler is not None and len(num_cols) > 0:\n","        numeric_transformer = Pipeline([(\"scaler\", scaler)])\n","        transformers.append((\"num\", numeric_transformer, num_cols))\n","\n","    if encoder is not None and len(cat_cols) > 0:\n","        categorical_transformer = Pipeline([(\"encoder\", encoder)])\n","        transformers.append((\"cat\", categorical_transformer, cat_cols))\n","\n","    preprocessor = ColumnTransformer(transformers=transformers)\n","\n","    # Build pipeline\n","    steps = [(\"preprocessor\", preprocessor)]\n","    if resampling is not None:\n","        steps.append((\"resampling\", resampling))\n","    steps.append((\"classifier\", model))\n","\n","    clf = Pipeline(steps=steps)\n","\n","    # Fit and predict\n","    clf.fit(X_train, y_train)\n","    y_pred = clf.predict(X_test)\n","\n","    return y_pred, clf, X_test\n"]},{"cell_type":"code","execution_count":64,"id":"30979bd1","metadata":{"execution":{"iopub.execute_input":"2026-08-24T21:18:38.410251Z","iopub.status.busy":"2026-08-24T21:18:38.409913Z","iopub.status.idle":"2026-08-24T21:18:38.419632Z","shell.execute_reply":"2026-08-24T21:18:38.418807Z"},"papermill":{"duration":0.053055,"end_time":"2026-08-24T21:18:38.421704+00:00","exception":false,"start_time":"2026-08-24T21:18:38.368649+00:00","status":"completed"},"tags":[]},"outputs":[],"source":["    \n","def model_eval(clf, y_pred, X_test, y_test, scoring=\"accuracy\", ):\n","    # Report\n","    report= classification_report(y_test, y_pred)\n","    print(f\"===================== CLASSIFICATION REPORT ============================\")\n","    print(report)\n","\n","    print(f\"\\n=================== MODEL ACCURACY SCORE =============================\")\n","    print(f\"Accuracy Score: {accuracy_score(y_test, y_pred)}\")\n","\n","    print(f\"\\n=================== MODEL PRECISION SCORE ============================\")\n","    print(f\"Precision Score: {round(precision_score(y_test, y_pred), 2)}\")\n","\n","    print(f\"\\n=================== MODEL F1 SCORE ===================================\")\n","    print(f\"F1 Score: {round(f1_score(y_test, y_pred), 2)}\")\n","\n","    print(f\"\\n=================== MODEL RECALL (SENSITIVITY) SCORE =================\")\n","    print(f\"Recall Score: {round(recall_score(y_test, y_pred), 2)}\")\n","\n","    print(f\"\\n=================== MODEL SPECIFICITY SCORE ==========================\")\n","    tn, fp, fn, tp = confusion_matrix(y_test, y_pred).ravel()\n","    specificity = round(tn / (tn + fp), 2)\n","    print(f\"Specificity: {specificity:.3f}\\n\")\n","\n","\n","    # confusion matrix\n","    cm= confusion_matrix(y_test, y_pred)\n","\n","    # Permutation importance on test set\n","    result = permutation_importance(\n","        clf, X_test, y_test,\n","        scoring=scoring\n","    )\n","\n","    feature_importance= pd.Series(result.importances_mean, index=clf.feature_names_in_)\n","    \n","    # Display results\n","    fig, axs= plt.subplots(figsize=(12, 6), nrows=1, ncols=2)\n","    \n","    sns.heatmap(cm, fmt=\"g\", annot=True, cbar=False, cmap=\"crest\", ax= axs[0])\n","    sns.barplot(feature_importance, ax=axs[1])\n","    \n","    plt.tick_params(axis=\"x\", rotation=90)\n","    axs[0].set_title(\"Confusion Matrix\")\n","    axs[1].set_title(\"Permutation Importance\")\n"