ine([(\"scaler\", scaler)])\n        transformers.append((\"num\", numeric_transformer, num_cols))\n\n    if encoder is not None and len(cat_cols) > 0:\n        categorical_transformer = Pipeline([(\"encoder\", encoder)])\n        transformers.append((\"cat\", categorical_transformer, cat_cols))\n\n    preprocessor = ColumnTransformer(transformers=transformers)\n\n    # Build pipeline\n    steps = [(\"preprocessor\", preprocessor)]\n    if resampling is not None:\n        steps.append((\"resampling\", resampling))\n    steps.append((\"classifier\", model))\n\n    clf = Pipeline(steps=steps)\n\n    # Fit and predict\n    clf.fit(X_train, y_train)\n    y_pred = clf.predict(X_test)\n\n    return y_pred, clf, X_test\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-09-07T15:59:07.223021Z","iopub.execute_input":"2026-09-07T15:59:07.223414Z","iopub.status.idle":"2026-09-07T15:59:07.233181Z","shell.execute_reply.started":"2026-09-07T15:59:07.223351Z","shell.execute_reply":"2026-09-07T15:59:07.23229Z"}},"outputs":[],"execution_count":63},{"cell_type":"code","source":"# Model Evalution function\ndef model_eval(clf, y_pred, X_test, y_test, scoring=\"accuracy\", ):\n    # Report\n    print(f\"===================== CLASSIFICATION REPORT ============================\")\n    report= classification_report(y_test, y_pred)\n    print(report)\n\n    print(f\"\\n=================== MODEL ACCURACY SCORE =============================\")\n    ac_score= accuracy_score(y_test, y_pred)\n    print(f\"Accuracy Score: {ac_score:.2f}\")\n\n    print(f\"\\n=================== MODEL PRECISION SCORE ============================\")\n    pr_score= precision_score(y_test, y_pred)\n    print(f\"Precision Score: {pr_score:.2f}\")\n\n    print(f\"\\n=================== MODEL F1 SCORE ===================================\")\n    f1= f1_score(y_test, y_pred)\n    print(f\"F1 Score: {f1:.2f}\")\n\n    print(f\"\\n=================== MODEL RECALL (SENSITIVITY) SCORE =================\")\n    rc_score = recall_score(y_test, y_pred)\n    print(f\"Recall Score: {rc_score:.2f}\")\n    \n    print(f\"\\n=================== MODEL SPECIFICITY SCORE ==========================\")\n    # confusion matrix\n    cm= confusion_matrix(y_test, y_pred)\n    \n    # Specificity\n    tn, fp, fn, tp = cm.ravel()\n    specificity = (tn / (tn + fp))\n    print(f\"Specificity: {specificity:.2f}\\n\")\n\n    # Permutation importance on test set\n    result = permutation_importance(\n        clf, X_test, y_test,\n        scoring=scoring\n    )\n\n    feature_importance= pd.Series(result.importances_mean, index=clf.feature_names_in_)\n    \n    # Display results\n    fig, axs= plt.subplots(figsize=(12, 6), nrows=1, ncols=2)\n    \n    sns.heatmap(cm, fmt=\"g\", annot=True, cbar=False, cmap=\"crest\", ax= axs[0])\n    sns.barplot(feature_importance, ax=axs[1])\n    \n    plt.tick_params(axis=\"x\", rotation=90)\n    axs[0].set_title(\"Confusion Matrix\")\n    axs[1].set_title(\"Permutation Importance\")\n    axs[1].tick_params(axis=\"x\", rotation=90)\n    \n    plt.tight_layout()\n    return fig","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-09-07T16:46:33.040629Z","iopub.execute_input":"2026-09-07T16:46:33.040958Z","iopub.status.idle":"2026-09-07T16:46:33.051596Z","shell.execute_reply.started":"2026-09-07T16:46:33.04093Z","shell.execute_reply":"2026-09-07T16:46:33.050575Z"}},"outputs":[],"execution_count":94},{"cell_type":"code","source":"y_pred, clf, X_test= anomaly_model(\n    model=LogisticRegression(), \n    df=df,\n)\n\nfig= model_eval(clf, y_pred, X_test, y_test, scoring=\"accuracy\")\n\nfig.savefig(\"log_reg_baseline_conf_mat_permu_feat.jpeg\", dpi=500)","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-09-07T16:46:35.399283Z","iopub.execute_input":"2026-09-07T16:46:35.399834Z","iopub.status.idle":"2026-09-07T16:46:38.434825Z","shell.execute_reply.started":"2026-09-07T16:46:35.399799Z","shell.execute_reply":"2026-09-07T16:46:38.4336